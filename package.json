{
  "name": "guitar-tuner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4750 --strictPort",
    "build": "tsc --noEmit && vite build",
    "serve": "npm run build && vite preview --host 127.0.0.1 --port 4750 --strictPort",
    "tunnel": "cloudflared tunnel --no-autoupdate --url http://127.0.0.1:4750",
    "check:pitch": "node scripts/check-pitch.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "pitchy": "^4.1.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0"
  }
}
